HDVIA_SECRET_KEY=
HDVIA_ADMIN_EMAIL=
HDVIA_DEMO_ADMIN_PASSWORD=
HDVIA_PUBLIC_BASE_URL=https://www.hdvia.vn
HDVIA_ALLOWED_HOSTS=hdvia.vn,www.hdvia.vn
PORT=8000
HDVIA_COOKIE_SECURE=1

# Beta public registration/login: social providers only.
# Create OAuth apps at each provider and add the exact callback URL:
# Google: register BOTH exact callback URLs
# https://hdvia.vn/auth/google/callback
# https://www.hdvia.vn/auth/google/callback
# Facebook: register BOTH exact callback URLs
# https://hdvia.vn/auth/facebook/callback
# https://www.hdvia.vn/auth/facebook/callback
# Zalo: register BOTH exact callback URLs
# https://hdvia.vn/auth/zalo/callback
# https://www.hdvia.vn/auth/zalo/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
ZALO_CLIENT_ID=
ZALO_CLIENT_SECRET=

# Open API Orchestrator 1.14.8
HDVIA_API_USER_AGENT=HDVIA-PublicAPI/1.14.8 (set-your-contact)
HDVIA_OPEN_API_TIMEOUT=10
HDVIA_OPEN_API_CACHE_TTL=900
HDVIA_LIVE_WEATHER=true
HDVIA_LIVE_GEOCODING=true
HDVIA_LIVE_ROUTING=false
HDVIA_LIVE_AIR_QUALITY=true
HDVIA_LIVE_MARINE=true
HDVIA_LIVE_OSM=true
HDVIA_LIVE_WIKIDATA=true
HDVIA_LIVE_WIKIPEDIA=true
HDVIA_LIVE_SUN=true
HDVIA_LIVE_OPENTRIPMAP=false
# Optional key for OpenTripMap; never commit a real key.
OPENTRIPMAP_API_KEY=

# Journey AI live data fusion
HDVIA_JOURNEY_LIVE_FUSION=true
HDVIA_JOURNEY_FUSION_MAX_PLACES=4

# HDVIA 1.23 AI Connect & Self-Update
# Get a Gemini API key from Google AI Studio and configure it at deployment time.
GEMINI_API_KEY=
HDVIA_GEMINI_MODEL=gemini-2.5-flash-lite
# Optional OpenAI-compatible provider (only if you have an appropriate API endpoint/key).
HDVIA_OPENAI_COMPAT_BASE=
HDVIA_OPENAI_COMPAT_API_KEY=
HDVIA_OPENAI_COMPAT_MODEL=
# 1.23.1 controlled self-update (opt-in)
HDVIA_AI_AUTO_ENRICH=0
HDVIA_SELF_UPDATE_FETCH_SOURCES=0
# Optional scheduler authentication; store the same secret in GitHub Actions.
HDVIA_SELF_UPDATE_CRON_TOKEN=
